# Copy to .env.local and fill in. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser — never put secrets in them.

# ── Pi Network (server-side) ─────────────────────────────────────────────────
PI_API_KEY=
PI_ISSUER_SECRET_KEY=        # signs contracts (Stellar secret key)
PI_ISSUER_PUBLIC_KEY=
PI_A2U_MAX_AMOUNT=10         # optional cap for app-to-user payments (Pi)

# ── Admin panel (server-side) ────────────────────────────────────────────────
ADMIN_PIN=
ADMIN_SESSION_SECRET=        # random, at least 32 characters (e.g. `openssl rand -hex 32`)

# ── Firebase Admin (server-side) ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=        # keep the \n escapes, wrap in double quotes
FIREBASE_STORAGE_BUCKET=

# ── Firebase client (public by design) ───────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Email for OTP (set Gmail OR Resend) ──────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=

# ── AI providers (server-side) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Backend (re-global-v2) ───────────────────────────────────────────────────
BACKEND_API_URL=             # preferred (server-only)
NEXT_PUBLIC_API_URL=         # fallback only

# ── Misc (public) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_PI_RPC=
NEXT_PUBLIC_SUBSCRIPTION_CONTRACT=
